rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/employeeMappings {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['mappings', 'knownNames', 'updatedAt'])
        && request.resource.data.mappings is map
        && request.resource.data.knownNames is list
        && request.resource.data.updatedAt is timestamp;
    }
  }
}
